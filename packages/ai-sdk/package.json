{
  "name": "@universal-mcp-toolkit/ai-sdk",
  "version": "1.0.0",
  "description": "Use 28 MCP servers from universal-mcp-toolkit with the Vercel AI SDK — streamText, generateText, and agent workflows in one line.",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-sdk",
    "vercel",
    "openai",
    "anthropic",
    "function-calling",
    "agent-tools",
    "streamtext",
    "generatetext"
  ],
  "author": "Mark Gatcha",
  "license": "MIT",
  "dependencies": {
    "@universal-mcp-toolkit/bridge": "workspace:*",
    "@universal-mcp-toolkit/core": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
